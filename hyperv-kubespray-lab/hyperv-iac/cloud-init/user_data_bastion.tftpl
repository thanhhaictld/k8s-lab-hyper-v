#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: ${hostname}
    username: ansible
    # Lab-only initial password: Enterprise
    # Replace this hash for any environment beyond an isolated lab.
    password: "$6$FWaQJuryH1xdWja1$uGrknm.0pO5YaxejeS2iTtmw.lxLLBCopI778vnTouyV/hNmfsIKWz.wQyNO90G/tkByTt97OlvOB9Av3o7Ci1"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ${ssh_public_key}

  storage:
    layout:
      name: direct

  packages:
    - python3
    - python3-apt
    - curl
    - ca-certificates
    - openssh-server
    - chrony
    - qemu-guest-agent

  late-commands:
    - curtin in-target --target=/target -- usermod -aG sudo ansible
    - curtin in-target --target=/target -- sh -c "echo 'ansible ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/ansible"
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/ansible
    - curtin in-target --target=/target -- systemctl enable ssh

  network:
    version: 2
    ethernets:
      eth0:
        match:
          macaddress: "${static_mac}"
        set-name: eth0
        addresses:
          - ${ip_address}/${subnet_prefix}
        routes:
          - to: default
            via: ${gateway}
        nameservers:
          addresses: [${dns_servers}]

  shutdown: reboot
